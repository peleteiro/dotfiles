#!/bin/bash

# Android SDK Command Line Tools version
# Update this when a new version is released
# Check latest version at: https://developer.android.com/studio#command-tools
# Or verify at: https://dl.google.com/android/repository/repository2-1.xml
export ANDROID_CMD_TOOLS_VERSION="13114758"

# Source validation utilities
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
# shellcheck disable=SC1091
source "$DIR/validate-url" 2>/dev/null || true

# Detect Homebrew path (Apple Silicon vs Intel)
if [ -d "/opt/homebrew" ]; then
  BREW_PATH="/opt/homebrew"
elif [ -d "/usr/local/Homebrew" ]; then
  BREW_PATH="/usr/local"
else
  BREW_PATH="/opt/homebrew"  # Default for Apple Silicon
fi

# Install homebrew if not already installed
if ! command -v brew > /dev/null 2>&1; then
  echo "Installing Homebrew..."
  HOMEBREW_URL="https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh"
  if validate_url "$HOMEBREW_URL" "Homebrew installer"; then
    /bin/bash -c "$(curl -fsSL "$HOMEBREW_URL")"
  else
    echo "❌ Could not download Homebrew installer"
    exit 1
  fi
fi

# Setup Homebrew environment
if [ -f "$BREW_PATH/bin/brew" ]; then
  eval "$($BREW_PATH/bin/brew shellenv)"
elif [ -f "/usr/local/bin/brew" ]; then
  eval "$(/usr/local/bin/brew shellenv)"
else
  # Try to find brew in PATH
  if command -v brew > /dev/null 2>&1; then
    eval "$(brew shellenv)"
  else
    echo "Error: Homebrew not found after installation"
    exit 1
  fi
fi

# Update homebrew
brew install git
brew update
brew upgrade

# install mas
brew install mas

# Install bash and zsh first (bash for dotfiles scripts, zsh as default user shell)
echo "📦 Installing bash and zsh..."
brew install bash zsh

# install essentials
brew install \
aria2 \
autoconf \
automake \
awscli \
bash-completion \
bat \
bottom \
coreutils \
delta \
docker-completion \
docker-compose \
dust \
exiftool \
gitui \
hub \
gnu-sed \
gpg \
hashdeep \
hyperfine \
imagemagick \
jpegoptim \
jq \
moreutils \
neovim \
openssl \
ouch \
pip-completion \
pngcrush \
procs \
ripgrep \
rnr \
sd \
sqlite \
ssh-copy-id \
starship \
tealdeer \
tigervnc \
tree \
zellij \
wget \
zlib \
exa \
fd \
zsh-autosuggestions \
zsh-syntax-highlighting \

# Register Homebrew bash and zsh in /etc/shells
BREW_BASH=$(brew --prefix)/bin/bash
BREW_ZSH=$(brew --prefix)/bin/zsh
for shell in "$BREW_BASH" "$BREW_ZSH"; do
  if [ -x "$shell" ] && ! grep -q "^${shell}$" /etc/shells; then
    echo "Adding $shell to /etc/shells..."
    echo "$shell" | sudo tee -a /etc/shells > /dev/null
  fi
done
echo "✅ Homebrew bash installed at $BREW_BASH (used by dotfiles scripts)"
echo "✅ Homebrew zsh installed at $BREW_ZSH"

# Set zsh as the default login shell
if [ -x "$BREW_ZSH" ]; then
  ZSH_PATH="$BREW_ZSH"
else
  ZSH_PATH=$(command -v zsh)
fi
CURRENT_SHELL=$(dscl . -read "/Users/$USER" UserShell 2>/dev/null | awk '{print $2}')
if [ "$CURRENT_SHELL" != "$ZSH_PATH" ]; then
  echo "🔄 Changing default shell to zsh..."
  if chsh -s "$ZSH_PATH"; then
    echo "✅ Default shell changed to zsh (takes effect on next login)"
  else
    echo "⚠️  Could not change shell automatically. Run: chsh -s $ZSH_PATH"
  fi
else
  echo "✅ zsh is already the default shell"
fi

# mise
# Note: mise.run doesn't support HEAD requests, so we skip validation and try directly
if ! command -v mise > /dev/null 2>&1; then
  echo "📥 Installing mise..."
  if curl -fsSL https://mise.run | sh; then
    echo "✅ mise installed"
  else
    echo "⚠️  Could not install mise (may need manual installation)"
  fi
else
  echo "✅ mise already installed"
fi

# Function to install cask only if not already installed
# Checks both Homebrew cask list and if app exists in /Applications
install_cask_if_missing() {
  local cask_name=$1
  local app_name="${2:-}"  # Optional: app name in /Applications (if different from cask name)
  
  # If app_name not provided, try to infer from cask_name
  if [ -z "$app_name" ]; then
    # Common mappings for cask names to app names
    case "$cask_name" in
      "1password") app_name="1Password.app" ;;
      "1password-cli") app_name="" ;;  # CLI tool, no app
      "antigravity") app_name="Antigravity.app" ;;
      "antigravity-cli") app_name="" ;;  # CLI tool (agy), no app
      "antigravity-ide") app_name="Antigravity IDE.app" ;;
      "cursor") app_name="Cursor.app" ;;
      "docker") app_name="Docker.app" ;;
      "droplr") app_name="Droplr.app" ;;
      "firefox") app_name="Firefox.app" ;;
      "google-chrome") app_name="Google Chrome.app" ;;
      "google-drive") app_name="Google Drive.app" ;;
      "hammerspoon") app_name="Hammerspoon.app" ;;
      "iconjar") app_name="IconJar.app" ;;
      "intellij-idea") app_name="IntelliJ IDEA.app" ;;
      "iterm2") app_name="iTerm.app" ;;
      "sublime-merge") app_name="Sublime Merge.app" ;;
      "sublime-text") app_name="Sublime Text.app" ;;
      "tableplus") app_name="TablePlus.app" ;;
      "the-unarchiver") app_name="The Unarchiver.app" ;;
      "transmit") app_name="Transmit.app" ;;
      "visual-studio-code") app_name="Visual Studio Code.app" ;;
      "vlc") app_name="VLC.app" ;;
      *) app_name="" ;;  # Unknown, will only check Homebrew
    esac
  fi
  
  # Check if already installed via Homebrew
  if brew list --cask "$cask_name" > /dev/null 2>&1; then
    echo "✅ $cask_name already installed (via Homebrew)"
    return 0
  fi
  
  # Check if app exists in /Applications (if app_name provided)
  if [ -n "$app_name" ] && [ -d "/Applications/$app_name" ]; then
    echo "✅ $cask_name already installed (found in /Applications)"
    return 0
  fi
  
  # Not installed, install it
  echo "📥 Installing $cask_name..."
  brew install --cask "$cask_name"
}

# install "out of appstore" apps
install_cask_if_missing 1password
install_cask_if_missing 1password-cli
install_cask_if_missing antigravity-cli
install_cask_if_missing antigravity
install_cask_if_missing antigravity-ide
install_cask_if_missing cursor
install_cask_if_missing docker
install_cask_if_missing droplr
install_cask_if_missing firefox
install_cask_if_missing google-chrome
install_cask_if_missing google-drive
install_cask_if_missing hammerspoon
install_cask_if_missing iconjar
install_cask_if_missing intellij-idea
install_cask_if_missing iterm2
install_cask_if_missing sublime-merge
install_cask_if_missing sublime-text
install_cask_if_missing tableplus
install_cask_if_missing the-unarchiver
install_cask_if_missing transmit
install_cask_if_missing visual-studio-code
install_cask_if_missing vlc

# Antigravity IDE CLI launcher. The cask ships two binary shims (antigravity-ide
# and the agy-ide alias), but when the app was installed outside Homebrew the
# cask is skipped and the shims are never created — link them ourselves.
ANTIGRAVITY_IDE_CLI="/Applications/Antigravity IDE.app/Contents/Resources/app/bin/antigravity-ide"
if [ -x "$ANTIGRAVITY_IDE_CLI" ]; then
  for link_name in antigravity-ide agy-ide; do
    if ! command -v "$link_name" > /dev/null 2>&1; then
      ln -sfn "$ANTIGRAVITY_IDE_CLI" "$BREW_PATH/bin/$link_name"
      echo "✅ Antigravity IDE CLI linked ($link_name)"
    else
      echo "✅ Antigravity IDE CLI already available ($link_name)"
    fi
  done
else
  echo "⚠️  Antigravity IDE CLI launcher not found (is the app installed?)"
fi

# install appstore apps
echo "💿 Amphetamine" && mas install 937984704
echo "💿 Audio Lock" && mas install 1460671099
echo "💿 Brother P Touch Editor" && mas install 1453365242
echo "💿 Capto" && mas install 1078184147
echo "💿 DaisyDisk" && mas install 411643860
echo "💿 Dato" && mas install 1470584107
echo "💿 HTTPBot" && mas install 1232603544
echo "💿 KeepSolid VPN" && mas install 694633015
echo "💿 Microsoft Remote Desktop" && mas install 1295203466
echo "💿 Monodraw" && mas install 920404675
echo "💿 Pastel" && mas install 413897608
echo "💿 Pixelmator Pro" && mas install 1289583905
echo "💿 Slack" && mas install 803453959
echo "💿 Spark Mail" && mas install 6445813049
echo "💿 TextSniper OCR" && mas install 1528890965
echo "💿 Typeface 3" && mas install 1062679359
echo "💿 Whatsapp Desktop" && mas install 310633997
echo "💿 XCode" && mas install 497799835
echo "💿 xScope 4" && mas install 889428659
echo "💿 Yubico Authenticator" && mas install 1497506650

# Android-SDK (só instala se não estiver instalado)
ANDROID_SDK_DIR="$HOME/.local/share/android"
if [ ! -d "$ANDROID_SDK_DIR/cmdline-tools" ] || [ ! -f "$ANDROID_SDK_DIR/cmdline-tools/latest/bin/sdkmanager" ]; then
  echo "📱 Installing Android SDK..."
  
  # Instalar OpenJDK se não estiver instalado
  if ! brew list openjdk > /dev/null 2>&1; then
    brew install openjdk
  fi
  
  BREW_PREFIX=$(brew --prefix)
  if [ ! -L "/Library/Java/JavaVirtualMachines/openjdk.jdk" ]; then
    sudo ln -sfn "$BREW_PREFIX/opt/openjdk/libexec/openjdk.jdk" /Library/Java/JavaVirtualMachines/openjdk.jdk
  fi
  
  # Baixar e instalar command line tools
  ANDROID_TOOLS_URL="https://dl.google.com/android/repository/commandlinetools-mac-${ANDROID_CMD_TOOLS_VERSION}_latest.zip"
  if validate_url "$ANDROID_TOOLS_URL" "Android command line tools"; then
    if safe_download "$ANDROID_TOOLS_URL" /tmp/commandlinetools.zip "Android command line tools"; then
      rm -rf /tmp/commandlinetools-tmp-unzip
      mkdir -p /tmp/commandlinetools-tmp-unzip
      # Use ouch if available (installed earlier), otherwise fallback to unzip
      if command -v ouch > /dev/null 2>&1; then
        ouch decompress /tmp/commandlinetools.zip --dir /tmp/commandlinetools-tmp-unzip
      else
        unzip -n /tmp/commandlinetools.zip -d /tmp/commandlinetools-tmp-unzip
      fi
      mkdir -p "$ANDROID_SDK_DIR"
      if cd "$ANDROID_SDK_DIR"; then
        yes | /tmp/commandlinetools-tmp-unzip/cmdline-tools/bin/sdkmanager --licenses --sdk_root="$ANDROID_SDK_DIR" 2>/dev/null || true
        yes | /tmp/commandlinetools-tmp-unzip/cmdline-tools/bin/sdkmanager --install "cmdline-tools;latest" --sdk_root="$ANDROID_SDK_DIR"
      fi
      rm -rf /tmp/commandlinetools-tmp-unzip
      rm /tmp/commandlinetools.zip
    else
      echo "⚠️  Skipping Android SDK installation due to download failure"
      exit 1
    fi
  else
    echo "⚠️  Skipping Android SDK installation due to URL validation failure"
    exit 1
  fi
  
  echo "✅ Android SDK installed"
else
  echo "✅ Android SDK already installed"
fi

# PlatformIO (via Homebrew)
if ! command -v platformio > /dev/null 2>&1; then
  echo "📥 Installing PlatformIO via Homebrew..."
  if brew install platformio; then
    echo "✅ PlatformIO installed"
  else
    echo "⚠️  Could not install PlatformIO via Homebrew"
  fi
else
  echo "✅ PlatformIO already installed"
fi

# Rustup
if ! command -v rustup > /dev/null 2>&1; then
  RUSTUP_URL="https://sh.rustup.rs"
  if validate_url "$RUSTUP_URL" "Rustup installer"; then
    curl --proto '=https' --tlsv1.2 -sSf "$RUSTUP_URL" | sh -s -- -y
  else
    echo "⚠️  Could not download Rustup installer"
  fi
fi

