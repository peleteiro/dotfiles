{
  "includeCoAuthoredBy": false,
  "gitAttribution": false,
  "preferredShell": "zsh",
  "permissions": {
    "allow": ["Bash(*)", "Edit(*)", "EditFiles(*)", "Read(*)", "ReadFiles(*)", "WebFetch(*)", "WebSearch(*)", "Skill(*)"],
    "deny": ["Bash(rm -rf /)", "Bash(rm -rf .git)", "Bash(git push --force*)", "Bash(git push -f*)", "Bash(git push --force-with-lease*)", "Bash(git commit --no-verify*)", "Bash(docker system prune)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/lint.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.pnpm-store/**",
    "**/pnpm-lock.yaml",
    "**/.git/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.env*",
    "**/*.log"
  ],
  "autoApprove": {
    "read": true,
    "edit": true
  },
  "customInstructions": "Use pnpm exclusively. For file manipulation and search, DO NOT USE sed, find or grep. Use the modern Rust alternatives: 'fd' (instead of find), 'rg' (ripgrep, instead of grep) and 'sd' (instead of sed). If you need to list files respecting the .gitignore, use 'fd'. For fast content searches, use 'rg'."
}
