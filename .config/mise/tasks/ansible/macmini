#!/bin/bash
#MISE description="Provisions only the Mac Mini (ansible/macmini.yml)"
# Usage:
#   mise run ansible:macmini             # applies
#   mise run ansible:macmini -- --check  # dry-run
#
# Validates the macmini secret before running. Requires an authenticated `op` on the
# controller (the ssh-keys role reads the key from 1Password).
set -euo pipefail

cd "$MISE_CONFIG_ROOT/ansible"
"$MISE_CONFIG_ROOT/.config/mise/tasks/ansible/check-secrets" macmini
exec ansible-playbook macmini.yml "$@"
