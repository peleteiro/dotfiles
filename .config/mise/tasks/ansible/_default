#!/bin/bash
#MISE description="Provisions ALL machines via Ansible (ansible/site.yml)"
# Usage:
#   mise run ansible                     # all active machines
#   mise run ansible -- --check          # dry-run
#
# Validates the secret of each ACTIVE machine (non-commented playbook in site.yml) before
# running. Requires an authenticated `op` on the controller (the ssh-keys role reads the key from 1Password).
set -euo pipefail

cd "$MISE_CONFIG_ROOT/ansible"

# Active machines = imported (non-commented) playbooks in site.yml.
# while-read loop (not `mapfile`) for compatibility with macOS's bash 3.2.
machines=()
while IFS= read -r m; do
  [ -n "$m" ] && machines+=("$m")
done < <(grep -E '^[[:space:]]*-[[:space:]]*import_playbook:' site.yml \
  | grep -oE '[a-z_-]+\.yml' | sed 's/\.yml$//')
"$MISE_CONFIG_ROOT/.config/mise/tasks/ansible/check-secrets" "${machines[@]}"

exec ansible-playbook site.yml "$@"
