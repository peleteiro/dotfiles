#!/bin/bash
#MISE description="Verifica o secrets.yml do Ansible (existe e tem a senha de cada máquina)"
# Uso: check-secrets <maquina>...  (ex.: macmini homeassistant)
# Chamado pelos runners antes de rodar o playbook. O secrets é ÚNICO
# (group_vars/all/secrets.yml) com uma chave <maquina>_become_password por máquina.
# Para cada máquina alvo garante que a sua chave existe e não é placeholder.
set -euo pipefail

cd "$MISE_CONFIG_ROOT/ansible"
secret="group_vars/all/secrets.yml"
example="group_vars/all/secrets.example.yml"

if [ "$#" -eq 0 ]; then
  echo "uso: check-secrets <maquina>... (ex.: macmini homeassistant)" >&2
  exit 2
fi

if [ ! -f "$secret" ]; then
  {
    echo "❌ $secret não existe."
    echo "   cp ansible/$example ansible/$secret   # e preencha as senhas"
  } >&2
  exit 1
fi

fail=0
for m in "$@"; do
  key="${m}_become_password"
  line=$(grep -E "^[[:space:]]*${key}[[:space:]]*:" "$secret" || true)
  if [ -z "$line" ]; then
    echo "❌ falta a chave '$key' em $secret (a máquina '$m' precisa dela)" >&2
    fail=1
  elif printf '%s' "$line" | grep -q 'PREENCHA'; then
    echo "❌ '$key' ainda com placeholder em $secret — preencha a senha real." >&2
    fail=1
  else
    echo "✅ $m: senha de sudo ok"
  fi
done

exit "$fail"
