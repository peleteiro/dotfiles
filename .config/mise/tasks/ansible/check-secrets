#!/bin/bash
#MISE description="Checks the Ansible secrets.yml (exists and has each machine's password)"
# Usage: check-secrets <machine>...  (e.g.: macmini homeassistant)
# Called by the runners before running the playbook. The secrets file is SINGLE
# (group_vars/all/secrets.yml) with one <machine>_become_password key per machine.
# For each target machine, ensures its key exists and is not a placeholder.
set -euo pipefail

cd "$MISE_CONFIG_ROOT/ansible"
secret="group_vars/all/secrets.yml"
example="group_vars/all/secrets.example.yml"

if [ "$#" -eq 0 ]; then
  echo "usage: check-secrets <machine>... (e.g.: macmini homeassistant)" >&2
  exit 2
fi

if [ ! -f "$secret" ]; then
  {
    echo "❌ $secret does not exist."
    echo "   cp ansible/$example ansible/$secret   # and fill in the passwords"
  } >&2
  exit 1
fi

fail=0
for m in "$@"; do
  key="${m}_become_password"
  line=$(grep -E "^[[:space:]]*${key}[[:space:]]*:" "$secret" || true)
  if [ -z "$line" ]; then
    echo "❌ missing key '$key' in $secret (machine '$m' needs it)" >&2
    fail=1
  elif printf '%s' "$line" | grep -q 'FILL_IN'; then
    echo "❌ '$key' still has the placeholder in $secret — fill in the real password." >&2
    fail=1
  else
    echo "✅ $m: sudo password ok"
  fi
done

exit "$fail"
