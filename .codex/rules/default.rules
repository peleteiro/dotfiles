# Execpolicy (Starlark) — command denies, equivalent to the `deny` in .claude/settings.json.
# Codex scans .codex/rules/*.rules at startup (only when the project is trusted).
# decision="forbidden" blocks WITHOUT a prompt. Compound commands are evaluated part by
# part (`git add . && rm -rf /` is stopped by the `rm`), so nothing can be smuggled in.
#
# Test with: codex execpolicy check --rules .codex/rules/default.rules -- <command>

# ── Git ──────────────────────────────────────────────────────────────────────
# Git (including normal `push`) is allowed; only FORCE PUSH and `--no-verify` are
# blocked (they rewrite history / bypass hooks). Behavioral rule: pushing should only
# happen when the user asks — see .agents/rules/005-git-push.md.
prefix_rule(
    pattern = ["git"],
    decision = "allow",
    justification = "Git commands (including normal push) are authorized in this project.",
)

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "Force push rewrites the remote history.",
)

prefix_rule(
    pattern = ["git", "push", "-f"],
    decision = "forbidden",
    justification = "Force push rewrites the remote history.",
)

prefix_rule(
    pattern = ["git", "push", "--force-with-lease"],
    decision = "forbidden",
    justification = "Force push rewrites the remote history.",
)

prefix_rule(
    pattern = ["git", "commit", "--no-verify"],
    decision = "forbidden",
    justification = "Commits must run the validation hooks.",
)

# ── System ───────────────────────────────────────────────────────────────────
# deny: Bash(rm -rf /)
prefix_rule(
    pattern = ["rm", "-rf", "/"],
    decision = "forbidden",
    justification = "rm -rf / wipes the system. Delete specific paths inside the repo.",
    match = ["rm -rf /"],
    not_match = ["rm -rf ./dist"],
)

# deny: Bash(rm -rf .git)
prefix_rule(
    pattern = ["rm", "-rf", ".git"],
    decision = "forbidden",
    justification = "rm -rf .git destroys the repository history.",
    match = ["rm -rf .git"],
    not_match = ["rm -rf ./tmp"],
)

# ── Docker (used only in the Linux tests) ────────────────────────────────────
# deny: Bash(docker system prune)
prefix_rule(
    pattern = ["docker", "system", "prune"],
    decision = "forbidden",
    justification = "docker system prune wipes images/volumes/cache of the ENTIRE local Docker.",
    match = ["docker system prune", "docker system prune -a --volumes"],
    not_match = ["docker system df"],
)
