# Linux-specific shared configurations

# Add pip locals to path
export PATH=~/.local/bin:$PATH

# 1Password SSH Agent integration
OP_SSH_SOCK="$HOME/.1password/agent.sock"

if [ -S "$OP_SSH_SOCK" ]; then
  export SSH_AUTH_SOCK="$OP_SSH_SOCK"
fi

# 1Password SSH key ID (used by my-key and by apply-files for git commit signing)
if command -v op > /dev/null; then
  export OP_SSH_KEY_ID="${OP_SSH_KEY_ID:-rlrevu2grubcpjfha6eshu5m6m}"
fi

# Linux-specific aliases
alias open=/usr/bin/xdg-open

# pbcopy/pbpaste for Linux
if command -v xclip > /dev/null; then
  alias pbcopy='xclip -selection clipboard'
  alias pbpaste='xclip -selection clipboard -o'
fi

