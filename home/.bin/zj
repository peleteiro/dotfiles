#!/bin/bash
# Zellij session helper
# Usage:
#   zj            -> attach to the most recently used session (or create "default" if none exist)
#   zj <name>     -> attach to <name>, creating it if it does not exist

set -e

if ! command -v zellij > /dev/null 2>&1; then
  echo "Error: zellij is not installed on this machine." >&2
  echo "Install via apt (Debian 13+/Ubuntu 24.04+): sudo apt install zellij" >&2
  echo "Or via cargo: cargo install --locked zellij" >&2
  echo "Or run from your dotfiles dir: ./dotfiles apply:install" >&2
  exit 127
fi

if [ -n "$1" ]; then
  exec zellij attach --create "$1"
fi

# No argument: pick the most recent session
LAST_SESSION=$(zellij list-sessions --short --no-formatting 2>/dev/null | head -n 1)

if [ -n "$LAST_SESSION" ]; then
  exec zellij attach "$LAST_SESSION"
fi

# No existing sessions: bootstrap with "default"
exec zellij attach --create default
