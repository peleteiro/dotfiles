#!/bin/bash
# Display SSH key (public or private) from 1Password
# Usage: my-key <public|private>

set -e

KEY_VISIBILITY="${1:-}"

if [ -z "$KEY_VISIBILITY" ]; then
  echo "Usage: my-key <public|private>" >&2
  exit 1
fi

if [ "$KEY_VISIBILITY" != "public" ] && [ "$KEY_VISIBILITY" != "private" ]; then
  echo "Error: parameter must be 'public' or 'private'" >&2
  exit 1
fi

OP_SSH_KEY_ID="${OP_SSH_KEY_ID:-}"

if [ -z "$OP_SSH_KEY_ID" ]; then
  echo "Error: OP_SSH_KEY_ID not set" >&2
  exit 1
fi

if ! command -v op > /dev/null 2>&1; then
  echo "Error: 1Password CLI (op) not found" >&2
  exit 1
fi

if [ "$KEY_VISIBILITY" = "public" ]; then
  # Try to get public key directly, or derive from private key
  KEY_CONTENT=$(op item get "$OP_SSH_KEY_ID" --fields "public key" 2>/dev/null \
                || op document get "$OP_SSH_KEY_ID" 2>/dev/null \
                || true)
  if [ -z "$KEY_CONTENT" ] || ! echo "$KEY_CONTENT" | rg -q "ssh-"; then
    # Extract from private key via ssh-keygen -y
    PRIVATE_KEY=$(op document get "$OP_SSH_KEY_ID" 2>/dev/null \
                  || op item get "$OP_SSH_KEY_ID" --fields "notesPlain" 2>/dev/null \
                  || true)
    if [ -n "$PRIVATE_KEY" ] && command -v ssh-keygen > /dev/null 2>&1; then
      TMP_KEY=$(mktemp)
      echo "$PRIVATE_KEY" > "$TMP_KEY"
      chmod 600 "$TMP_KEY"
      ssh-keygen -y -f "$TMP_KEY" 2>/dev/null
      rm -f "$TMP_KEY"
    else
      echo "Error: Could not retrieve SSH public key" >&2
      exit 1
    fi
  else
    echo "$KEY_CONTENT"
  fi
else
  op document get "$OP_SSH_KEY_ID" 2>/dev/null \
    || op item get "$OP_SSH_KEY_ID" --fields "notesPlain" 2>/dev/null
fi
