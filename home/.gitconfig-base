[alias]
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset' --abbrev-commit --date=relative
  w = whatchanged
[github]
  user = peleteiro
[core]
  # editor will be set by GUI/non-GUI config
  # GUI: subl -n -w (Sublime Text)
  # Non-GUI: nvim (Neovim)
  # pager will be set by GUI/non-GUI config
  # Both GUI and non-GUI: delta
  whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol
[color]
  diff = auto
  status = auto
  branch = auto
  interactive = auto
  ui = true
  pager = true
[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green
[color "diff"]
  meta = yellow bold
  frag = magenta bold
  old = red bold
  new = green bold
[color "status"]
  added = yellow
  changed = green
  untracked = cyan
[user]
  name = Jose Peleteiro
  email = jose@peleteiro.net
[branch]
  autosetuprebase = always
  defaultBranch = main
[init]
  defaultBranch = main
[gist]
  private = true
[push]
  default = matching
# Always use SSH for authentication (not HTTPS)
[url "git@github.com:"]
  insteadOf = https://github.com/
# Sign commits and tags with SSH key (signing happens via the 1Password SSH agent).
# `commit.gpgsign` / `tag.gpgsign` are NOT enabled here — apply-files turns them on
# only when an SSH agent that responds is detected, so clones on headless boxes
# without 1Password Desktop still allow `git commit` to succeed.
[gpg]
  format = ssh
[user]
  signingkey = key::ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAElRssKJxkwEFC/eQLwyF/qldy4dOAFIUrzCJ8x5sl2

# SOPS (Secrets Operations) integration
[diff "sops"]
  textconv = sops -d

