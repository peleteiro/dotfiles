// Zellij configuration
// Docs: https://zellij.dev/documentation/

// === Appearance ===
// "compact" layout: a single thin status bar at the bottom
default_layout "compact"

// Hides pane frames (the active pane is highlighted by color)
pane_frames false

// Custom theme: Catppuccin Mocha pastel palette + soft black background
theme "mocha-black"

// Modern underlines (curly/dotted) in terminals that support them
styled_underlines true

// === Behavior ===
mouse_mode true
copy_on_select true

// Scrollback — equivalent to the history-limit 10000 I had in tmux
scroll_buffer_size 10000

// Editor to open the scrollback (Alt+e in scroll mode)
scrollback_editor "/usr/bin/env nvim"

// === Persistent sessions (Zellij 0.40+) ===
session_serialization true
pane_viewport_serialization true

// === Less noise at startup ===
show_startup_tips false
show_release_notes false

// === Custom theme ===
// Catppuccin Mocha (pastel colors) with a soft black background instead of the original #1e1e2e
themes {
    mocha-black {
        fg      "#cdd6f4"   // text: soft lavender-white
        bg      "#1a1a1a"   // background: near-black
        black   "#45475a"   // bright black: neutral gray
        red     "#f38ba8"   // pastel pink
        green   "#a6e3a1"   // mint green
        yellow  "#f9e2af"   // cream
        blue    "#89b4fa"   // sky blue
        magenta "#f5c2e7"   // light pink
        cyan    "#94e2d5"   // soft turquoise
        white   "#bac2de"   // grayish off-white
        orange  "#fab387"   // peach
    }
}
