#!/bin/bash
# Main script to manage dotfiles
# Replaces Makefile with subcommands

set -e

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
OS=$(uname)

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Help function
show_help() {
  cat << EOF
Usage: $0 <command> [options]

Available commands:
  apply            Run apply:config, apply:install, apply:files and apply:agents (in order)
  apply:config     Configure operating system (macOS or Linux)
  apply:install    Install packages and applications
  apply:files      Copy dotfiles to home directory
  apply:agents     Symlink global AI agent skills and instructions
  help             Show this help message

Examples:
  $0 apply            # Run everything (config + install + files + agents)
  $0 apply:config     # Configure macOS
  $0 apply:install   # Install packages
  $0 apply:files     # Copy only dotfiles
  $0 apply:agents    # Link only the agent collection

For more information, see README.md
EOF
}

# Function to run commands with feedback
run_command() {
  local cmd="$1"
  local description="$2"
  
  echo -e "${BLUE}▶${NC} ${description}..."
  if eval "$cmd"; then
    echo -e "${GREEN}✅${NC} ${description} completed"
    echo ""
  else
    echo -e "${RED}❌${NC} ${description} failed"
    exit 1
  fi
}

# Command: apply:files
cmd_apply_files() {
  run_command "$DIR/bin/apply-files" "Copying dotfiles"
}

# Command: apply:agents
cmd_apply_agents() {
  run_command "$DIR/bin/apply-agents" "Linking agent collection"
}

# Command: apply:config
cmd_apply_config() {
  if [[ "$OS" == "Darwin" ]]; then
    run_command "$DIR/bin/apply-config-macos" "Configuring macOS"
  else
    run_command "$DIR/bin/apply-config-linux" "Configuring Linux"
  fi
}

# Command: apply:install
cmd_apply_install() {
  if [[ "$OS" == "Darwin" ]]; then
    run_command "$DIR/bin/apply-install-macos" "Installing packages on macOS"
  else
    run_command "$DIR/bin/apply-install-linux" "Installing packages on Linux"
  fi
}

# Command: apply
cmd_apply() {
  echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
  echo -e "${BLUE}🚀 Running complete configuration${NC}"
  echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
  echo ""
  
  if [[ "$OS" == "Darwin" ]]; then
    cmd_apply_config
  fi
  
  cmd_apply_install
  cmd_apply_files
  cmd_apply_agents

  echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
  echo -e "${GREEN}✅ Complete configuration finished!${NC}"
  echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
  echo ""
}

# Process arguments
case "${1:-help}" in
  apply)
    cmd_apply
    ;;
  apply:config)
    cmd_apply_config
    ;;
  apply:install)
    cmd_apply_install
    ;;
  apply:files)
    cmd_apply_files
    ;;
  apply:agents)
    cmd_apply_agents
    ;;
  help|--help|-h)
    show_help
    ;;
  *)
    echo -e "${RED}❌${NC} Unknown command: $1"
    echo ""
    show_help
    exit 1
    ;;
esac

